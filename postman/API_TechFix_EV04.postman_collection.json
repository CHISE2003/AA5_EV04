{
  "info": {
    "name": "API TechFix - Testing AA5-EV04",
    "description": "Pruebas de autenticación, clientes, equipos y órdenes de servicio. Ejecutar con Collection Runner en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Estado del servicio",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Datos únicos por ejecución para poder repetir las pruebas",
              "pm.collectionVariables.set('usuario', 'tecnico_' + Date.now());",
              "pm.collectionVariables.set('documento', String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código de estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Contenido de la respuesta', () => { pm.expect(pm.response.json().estado).to.eql('activo'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": []
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 - Registro exitoso",
      "event": [
